# Keep real values only in backend/.env (which is gitignored).
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/oauth/callback
